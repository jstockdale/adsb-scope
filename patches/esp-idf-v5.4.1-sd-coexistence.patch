+                s_diskio_write_retries++;
+                ESP_LOGW(TAG, "sdmmc_write_blocks retry %d/%d (sector=%lu count=%u err=0x%x)",
+                         retry, DISKIO_MAX_RETRIES, (unsigned long)sector, count, err);
+                vTaskDelay(pdMS_TO_TICKS(DISKIO_RETRY_DELAY_MS));
+
+                sdspi_host_clear_garbled_flag();
+                err = sdmmc_write_sectors(card, buff, sector, count);
