  * may be dropped. We ignore this problem for now, since the there are no other
  * interesting events which can get lost due to this.
  */
+// ── ADS-B Scope: ISR diagnostics ─────────────────────────────────────
+static volatile uint32_t s_sdmmc_isr_count = 0;
+static volatile int64_t  s_sdmmc_isr_last_us = 0;
+
+void sdmmc_host_get_isr_stats(uint32_t *count, int64_t *last_us)
+{
+    if (count)   *count   = s_sdmmc_isr_count;
+    if (last_us) *last_us = s_sdmmc_isr_last_us;
+}
+
 static void sdmmc_isr(void *arg)
 {
+    s_sdmmc_isr_count++;
+    s_sdmmc_isr_last_us = esp_timer_get_time();
+
     QueueHandle_t queue = (QueueHandle_t) arg;
     sdmmc_event_t event;
     int higher_priority_task_awoken = pdFALSE;
@@ -1195,3 +1208,71 @@ esp_err_t sdmmc_host_get_state(sdmmc_host_state_t* state)
 #endif
     return ESP_OK;
 }
+
+// ── ADS-B Scope: SDHOST interrupt masking for SPI coexistence ────────
+//
+// On ESP32-P4 with ESP-Hosted (SDIO) and SD card (GP-SPI3), the SDHOST
+// ISR can fire during a GP-SPI3 polling transaction, causing a
+// portYIELD_FROM_ISR() that disrupts the SPI master's internal state
+// (host->polling / cur_cs tracking), resulting in ESP_ERR_INVALID_STATE.
+//
+// These functions allow the SD card driver to mask the SDHOST interrupt
+// during SPI transactions.  The C6 buffers outbound data, and the
+// SDHOST peripheral latches pending interrupts — nothing is lost,
+// just delayed by the duration of the SPI transaction (~20ms max).
+
+esp_err_t sdmmc_host_intr_disable(void)
+{
+    if (s_host_ctx.intr_handle) {
+        return esp_intr_disable(s_host_ctx.intr_handle);
+    }
+    return ESP_ERR_INVALID_STATE;
+}
+
+esp_err_t sdmmc_host_intr_enable(void)
+{
+    if (s_host_ctx.intr_handle) {
+        return esp_intr_enable(s_host_ctx.intr_handle);
+    }
+    return ESP_ERR_INVALID_STATE;
+}
+
+bool sdmmc_host_is_idmac_idle(void)
+{
+    if (!s_host_ctx.hal.dev) return true;  // not initialized
+
+    // IDSTS[16:13] = DMAC FSM state.  0 = DMA_IDLE.
+    uint32_t idsts = s_host_ctx.hal.dev->idsts.val;
+    uint32_t fsm = (idsts >> 13) & 0xF;
+
+    // Also check if card data lines are busy
+    bool data_busy = s_host_ctx.hal.dev->status.data_busy;
+
+    return (fsm == 0) && !data_busy;
+}
+
+// ── ADS-B Scope: SDHOST quiesce/resume for SD write protection ──────
+// Disable the IDMAC DMA engine at the hardware level to eliminate
+// SDHOST AXI bus traffic during GP-SPI3 SD card writes.  Even with
+// IDMAC idle (FSM state 0), the DMA engine's bus interface may still
+// poll for new descriptors.  Disabling BMOD.enable truly silences it.
+//
+// Card clock is NOT touched — the clock update pseudo-command times out
+// when the CIU is in certain states, causing 0x107 errors on every
+// flush.  The card clock doesn't generate AXI bus traffic anyway (it's
+// internal to the SDHOST peripheral).
+//
+// Call quiesce AFTER verifying IDMAC is idle and holding the DMA fence.
+// Call resume BEFORE unmasking the ISR and releasing the DMA fence.
+
+void sdmmc_host_quiesce(void)
+{
+    if (!s_host_ctx.hal.dev) return;
+    sdmmc_ll_enable_dma(s_host_ctx.hal.dev, false);
+}
+
+void sdmmc_host_resume(void)
+{
+    if (!s_host_ctx.hal.dev) return;
+    sdmmc_ll_enable_dma(s_host_ctx.hal.dev, true);
+}
