+                if (err == ESP_OK) {
+                    ESP_LOGI(TAG, "sdmmc_write_blocks succeeded on retry %d "
+                             "(original err=0x%x)", retry, original_err);
+                    /* Successful retry = card state is known-good.  The card
+                     * either rejected the bad write cleanly (CRC) or recovered
+                     * from a transient condition (timeout, invalid state).
+                     * No power cycle needed — that would cause more disruption
+                     * than the original error. */
+                    s_diskio_sectors_written += count;
+                    return RES_OK;
+                }
+
+                // Check if THIS retry produced a garbled response
+                if (sdspi_host_had_garbled_response()) {
+                    sdspi_host_clear_garbled_flag();
+                    s_diskio_card_needs_reset = true;
+                    ESP_LOGE(TAG, "Garbled response on retry %d — aborting, card needs power cycle", retry);
+                    break;
+                }
+
+                if (!diskio_err_is_retriable(err)) {
+                    break;  /* non-transient error — stop retrying */
+                }
+            }
+        }
+        /* All retries exhausted or garbled — card state is definitely uncertain */
+        s_diskio_card_needs_reset = true;
+        s_diskio_write_fails++;
+        ESP_LOGE(TAG, "sdmmc_write_blocks failed (0x%x) — card needs reset", err);
         return RES_ERROR;
     }
+    s_diskio_sectors_written += count;
     return RES_OK;
 }
 
