  * SPDX-License-Identifier: Apache-2.0
+ *
+ * Modified by jstockdale (ADS-B Scope) — added retry logic for transient
+ * CRC errors (0x109) and timeouts (0x107) in ff_sdmmc_write/ff_sdmmc_read.
+ * On ESP32-P4 T-Display-P4, WiFi activity on the co-processor C6 causes
+ * intermittent SPI signal corruption that the SD card detects as CRC
+ * failures.  A brief delay and retry is sufficient to recover from these
+ * transient glitches without propagating the error up to FatFS (which
+ * would cause a short write / partial flush and risk FAT corruption).
  */
 
 #include "diskio_impl.h"
@@ -10,12 +18,74 @@
 #include "sdmmc_cmd.h"
 #include "esp_log.h"
 #include "esp_compiler.h"
+#include "esp_err.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
 
 static sdmmc_card_t* s_cards[FF_VOLUMES] = { NULL };
 static bool s_disk_status_check_en[FF_VOLUMES] = { };
 
 static const char* TAG = "diskio_sdmmc";
 
+/* ── Retry configuration ──────────────────────────────────────────── */
+#define DISKIO_MAX_RETRIES        3     /* attempts after the first failure  */
+#define DISKIO_RETRY_DELAY_MS     10    /* ms between retries                */
+
+/* Errors worth retrying — transient signal integrity issues.
+ * ESP_ERR_INVALID_CRC      (0x109) — card detected corrupted data on SPI bus
+ * ESP_ERR_TIMEOUT          (0x107) — card didn't respond (busy / noise)
+ * ESP_ERR_INVALID_STATE    (0x108) — SPI state machine confused / card busy
+ * ESP_ERR_INVALID_RESPONSE (0x106) — card returned 0xFF or garbage response
+ *                                    token (e.g. busy during internal write)
+ */
+static inline bool diskio_err_is_retriable(esp_err_t err)
+{
+    return (err == ESP_ERR_INVALID_CRC ||
+            err == ESP_ERR_TIMEOUT ||
+            err == ESP_ERR_INVALID_STATE ||
+            err == ESP_ERR_INVALID_RESPONSE);
+}
+
+/* ── IO counters (debug diagnostics) ─────────────────────────────── */
+static uint32_t s_diskio_sectors_written = 0;
+static uint32_t s_diskio_sectors_read    = 0;
+static uint32_t s_diskio_write_retries   = 0;
+static uint32_t s_diskio_read_retries    = 0;
+static uint32_t s_diskio_write_fails     = 0;
+static uint32_t s_diskio_read_fails      = 0;
+
+/* ── Card state uncertainty flag ─────────────────────────────────── */
+/* Set when a write encounters a non-CRC error (garbled response, SPI
+ * state confusion, timeout).  CRC errors are "clean" — the card
+ * rejected the write and its state is known.  Everything else leaves
+ * the card in an uncertain state: the card may have partially processed
+ * a garbled command.  The caller should power-cycle and remount.
+ *
+ * Also set when all retries are exhausted (any error type).
+ */
+static volatile bool s_diskio_card_needs_reset = false;
+
+bool diskio_card_needs_reset(void) {
+    return s_diskio_card_needs_reset;
+}
+
+void diskio_clear_card_reset_flag(void) {
+    s_diskio_card_needs_reset = false;
+}
+
+void diskio_sdmmc_get_stats(uint32_t *wr_sectors, uint32_t *rd_sectors,
+                            uint32_t *wr_retries, uint32_t *rd_retries,
+                            uint32_t *wr_fails,   uint32_t *rd_fails)
+{
+    if (wr_sectors) *wr_sectors = s_diskio_sectors_written;
+    if (rd_sectors) *rd_sectors = s_diskio_sectors_read;
+    if (wr_retries) *wr_retries = s_diskio_write_retries;
+    if (rd_retries) *rd_retries = s_diskio_read_retries;
+    if (wr_fails)   *wr_fails   = s_diskio_write_fails;
+    if (rd_fails)   *rd_fails   = s_diskio_read_fails;
+}
+
+
 //Check if SD/MMC card is present
 static DSTATUS ff_sdmmc_card_available(BYTE pdrv)
 {
@@ -53,9 +123,29 @@ DRESULT ff_sdmmc_read (BYTE pdrv, BYTE* buff, DWORD sector, UINT count)
     assert(card);
     esp_err_t err = sdmmc_read_sectors(card, buff, sector, count);
     if (unlikely(err != ESP_OK)) {
+        /* Retry on transient CRC / timeout errors */
+        if (diskio_err_is_retriable(err)) {
+            for (int retry = 1; retry <= DISKIO_MAX_RETRIES; retry++) {
+                s_diskio_read_retries++;
+                ESP_LOGW(TAG, "sdmmc_read_blocks retry %d/%d (sector=%lu count=%u err=0x%x)",
+                         retry, DISKIO_MAX_RETRIES, (unsigned long)sector, count, err);
+                vTaskDelay(pdMS_TO_TICKS(DISKIO_RETRY_DELAY_MS));
+                err = sdmmc_read_sectors(card, buff, sector, count);
+                if (err == ESP_OK) {
+                    ESP_LOGI(TAG, "sdmmc_read_blocks succeeded on retry %d", retry);
+                    s_diskio_sectors_read += count;
+                    return RES_OK;
+                }
+                if (!diskio_err_is_retriable(err)) {
+                    break;  /* non-transient error — stop retrying */
+                }
+            }
+        }
+        s_diskio_read_fails++;
