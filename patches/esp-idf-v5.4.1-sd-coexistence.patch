diff --git a/components/esp_driver_sdmmc/src/sdmmc_host.c b/components/esp_driver_sdmmc/src/sdmmc_host.c
index ac8f00b..79f42cc 100644
--- a/components/esp_driver_sdmmc/src/sdmmc_host.c
