# adsb-scope sdkconfig.defaults
#
# Effective-parity with the T-Display-P4 build of 2026-04 (fork 6fd3692),
# with silently-ignored / wrong-name keys corrected.  Every correction is
# listed in VENDOR.md ("sdkconfig corrections").  Ground truth for the
# corrections is the generated sdkconfig from the known-good build
# (ESP-IDF v5.4.1).

CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Alternate table with a model partition: partitions_model.csv

# ─── Application selector ─────────────────────────────────────────────────
# This repo builds exactly one app.  (The old tree's stale
# CONFIG_EXAMPLE_BUILD_LVGL_9_UI selector is gone — see VENDOR.md.)
CONFIG_EXAMPLE_BUILD_ADSB_RECEIVER=y

# ─── FreeRTOS Tick Rate (~1ms) ────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# ─── PSRAM memory optimization ────────────────────────────────────────────
# Move LWIP/net80211/wpa .bss to PSRAM (saves ~18KB internal)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Allow any-size malloc to go to internal (0 = no threshold, PSRAM preferred by other flags)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# DMA reserve pool at 32KB
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# LWIP runtime allocs prefer PSRAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Allow task stacks in PSRAM
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# CORRECTED: the old defaults requested FLASHFREQ_120M, which is not a valid
# option for this flash mode on ESP32-P4 and was silently ignored; the
# known-good generated sdkconfig resolved to 80 MHz.  State it explicitly.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_FATFS_LFN_HEAP=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y

CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_WN_WN9_HILEXIN=y

CONFIG_LV_CONF_SKIP=y
CONFIG_LV_USE_OBSERVER=y

CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_PERF_MONITOR_ALIGN_BOTTOM_RIGHT=y

CONFIG_LV_USE_FS_STDIO=y

CONFIG_LV_USE_LODEPNG=y

CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y

CONFIG_LV_USE_CLIB_MALLOC=y

CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y

CONFIG_TINYUSB_CDC_ENABLED=y

CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_SC2336_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_SC2336_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="components/private_library/sc2336_ipa_config.json"
CONFIG_CAMERA_SC2336_MIPI_RAW10_1280x720_30FPS=y

CONFIG_CAMERA_OV2710=y
CONFIG_CAMERA_OV2710_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_OV2710_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="components/private_library/ov2710_ipa_config.json"
CONFIG_CAMERA_OV2710_MIPI_RAW10_1280X720_25FPS=y

CONFIG_CAMERA_OV5645=y
CONFIG_CAMERA_OV5645_MIPI_RGB565_1280X960_30FPS=y

# ─── WiFi (ESP-Hosted via C6 on SDMMC Slot 1) ────────────────────────────
# Minimize P4 internal RAM usage — actual WiFi buffers live on C6.
# CORRECTED key names: the old defaults used CONFIG_ESP_HOSTED_TRANSPORT_SDIO
# and CONFIG_ESP_HOSTED_SDIO_*_GPIO, which do not exist in the esp_hosted
# Kconfig and were silently ignored.  The build worked anyway because the
# slot-1 defaults (CLK18 CMD19 D0-D3=14-17) happen to match the T-Display-P4
# wiring.  The keys below are the real ones from the known-good generated
# sdkconfig.  When adding a new board, set pins with these key names.
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_ESP_HOSTED_DFLT_TASK_STACK=5120
CONFIG_ESP_HOSTED_RPC_TASK_STACK=5120
CONFIG_ESP_HOSTED_TRANSPORT_RESTART_ON_FAILURE=n
# UNVERIFIED key (kept from old defaults; not observed in the generated
# sdkconfig — may be ignored on v5.4.1; see VENDOR.md "unverified keys"):
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_RX_BUF_SIZE=16384
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
# NOTE: generated sdkconfig shows SOFTAP_SUPPORT=y despite this line —
# likely select-forced by esp_wifi_remote.  Kept for intent; harmless.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# ─── LWIP (small buffers — NTP only, no heavy traffic on P4) ─────────────
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=4096
CONFIG_LWIP_TCP_WND_DEFAULT=4096
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_SNTP_MAX_SERVERS=1

CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=8192

CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y

# ─── Move mbedTLS allocations to PSRAM ────────────────────────────────────────
# Without this, mbedTLS uses malloc() which may allocate in internal RAM
# even with CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0 (mbedTLS has its own
# allocation path in some ESP-IDF versions).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ─── Certificate bundle: disabled ────────────────────────────────────────────
# We embed the ISRG Root X1 PEM directly in mqtt_feeder.c for Let's Encrypt.
# The default full bundle (200 CAs) wastes ~64KB flash and PSRAM parse buffers
# that are never used. Disable it entirely.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# ─── Don't keep peer certificate after TLS handshake ─────────────────────────
# Saves ~1.5KB per connection (the server cert chain). We only have one
# persistent MQTT connection and never re-verify after handshake.
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

# ─── Ethernet DMA: reduced buffers ────────────────────────────────────────
# The T-Display-P4 has an internal EMAC that should work when plugged in.
# The default 20 RX + 10 TX DMA buffers (512B each = 15,360 bytes) is
# overkill — 4+4 is plenty for MQTT-level traffic and saves 11,264 bytes
# of DMA-capable internal RAM that the SD card SPI bus needs.
CONFIG_ETH_DMA_RX_BUFFER_NUM=4
CONFIG_ETH_DMA_TX_BUFFER_NUM=4

# ─── TinyUSB for USB MSC mode ──────────────────────────────────────────────
CONFIG_TINYUSB_ENABLED=y
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096

# ─── Reduce TLS record buffer sizes ──────────────────────────────────────────
# Default is 16384 (16 KB) per direction = 32 KB for both.
# MQTT payloads are small (our largest is ~4 KB JSON batch).
# 4096 bytes is sufficient and saves 24 KB.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=6144
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# ─── CPU accounting ───────────────────────────────────────────────────────
# Per-task run-time counters for the console `top` command (how much of
# each core is in use, and by what). Cost: one timer read per context switch.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
